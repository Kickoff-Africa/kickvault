# Server
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Database
DATABASE_URL=postgresql://kickvault:kickvault@localhost:5432/kickvault

# Encryption key — MUST be exactly 64 hex characters (256-bit key)
# Generate a secure key with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_ENCRYPTION_KEY=

# Initial SUPER_ADMIN seed — only runs once (skipped if any SUPER_ADMIN already exists)
# Remove or leave blank after first deployment to disable
SEED_ADMIN_EMAIL=work@kickoff.africa
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_PASSWORD=ChangeMe@2026!
