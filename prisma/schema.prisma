generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  MANAGER
  MEMBER
  VIEWER
}

enum AssetCategory {
  HARDWARE
  SOFTWARE
  DIGITAL
  INTANGIBLE
}

enum AssetStatus {
  ACTIVE
  MAINTENANCE
  RETIRED
  LOST
}

enum PermissionLevel {
  VIEW
  EDIT
  MANAGE
}

// ─── Users ───────────────────────────────────────────────────────────────────

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String
  passwordHash   String    @map("password_hash")
  role           Role      @default(MEMBER)
  isActive       Boolean   @default(true) @map("is_active")
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil      DateTime? @map("locked_until")
  resetTokenHash   String?   @map("reset_token_hash")
  resetTokenExpiry DateTime? @map("reset_token_expiry")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  inviteTokenHash    String?   @map("invite_token_hash")
  inviteTokenExpiry  DateTime? @map("invite_token_expiry")
  phone          String?   @map("phone")
  department     String?   @map("department")
  location       String?   @map("location")
  bio            String?   @map("bio")
  lastLoginAt      DateTime? @map("last_login_at")
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  sessions         Session[]
  credentials      Credential[]
  assets           Asset[]
  credentialAccess CredentialAccess[]
  assetAccess      AssetAccess[]
  auditLogs        AuditLog[]

  @@map("users")
}

// ─── Sessions ────────────────────────────────────────────────────────────────

model Session {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  refreshToken String   @unique @map("refresh_token")
  userAgent    String?  @map("user_agent")
  ipAddress    String?  @map("ip_address")
  expiresAt    DateTime @map("expires_at")
  lastActiveAt DateTime @default(now()) @map("last_active_at")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ─── Credentials ─────────────────────────────────────────────────────────────

model Credential {
  id             String    @id @default(cuid())
  friendlyName   String    @map("friendly_name")
  systemHost     String?   @map("system_host")
  username       String?
  encryptedValue String    @map("encrypted_value")
  iv             String
  authTag        String    @map("auth_tag")
  keyVersion     Int       @default(1) @map("key_version")
  expiresAt      DateTime? @map("expires_at")
  deletedAt      DateTime? @map("deleted_at")
  createdById    String    @map("created_by_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  createdBy        User               @relation(fields: [createdById], references: [id])
  credentialAccess CredentialAccess[]

  @@index([createdById])
  @@index([expiresAt])
  @@index([deletedAt])
  @@map("credentials")
}

// ─── Assets ──────────────────────────────────────────────────────────────────

model Asset {
  id          String        @id @default(cuid())
  assetId     String        @unique @map("asset_id")
  name        String
  category    AssetCategory
  status      AssetStatus   @default(ACTIVE)
  location    String?
  notes       String?
  deletedAt   DateTime?     @map("deleted_at")
  createdById String        @map("created_by_id")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  createdBy   User          @relation(fields: [createdById], references: [id])
  assetAccess AssetAccess[]

  @@index([assetId])
  @@index([category])
  @@index([status])
  @@index([deletedAt])
  @@map("assets")
}

// ─── ACL Join Tables ─────────────────────────────────────────────────────────

model CredentialAccess {
  id           String          @id @default(cuid())
  userId       String          @map("user_id")
  credentialId String          @map("credential_id")
  permission   PermissionLevel @default(VIEW)
  grantedAt    DateTime        @default(now()) @map("granted_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  credential Credential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@unique([userId, credentialId])
  @@index([credentialId])
  @@map("credential_access")
}

model AssetAccess {
  id         String          @id @default(cuid())
  userId     String          @map("user_id")
  assetId    String          @map("asset_id")
  permission PermissionLevel @default(VIEW)
  grantedAt  DateTime        @default(now()) @map("granted_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([userId, assetId])
  @@index([assetId])
  @@map("asset_access")
}

// ─── Audit Log ───────────────────────────────────────────────────────────────

/// Append-only audit log. No updatedAt by design — entries are immutable.
/// Immutability enforced at application layer (Prisma middleware) and
/// database layer (PostgreSQL BEFORE UPDATE OR DELETE trigger).
model AuditLog {
  id         String   @id @default(cuid())
  action     String
  targetType String   @map("target_type")
  targetId   String?  @map("target_id")
  userId     String   @map("user_id")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([targetType, targetId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
